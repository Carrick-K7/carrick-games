{
  "name": "carrick-games",
  "private": true,
  "type": "module",
  "description": "Independently released browser games in one quiet Carrick Games shell",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/*",
    "games/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "node scripts/check.mjs types",
    "check:boundaries": "node scripts/check.mjs boundaries",
    "build": "node scripts/build.mjs",
    "build:game": "node scripts/build.mjs game",
    "build:shell": "node scripts/build.mjs shell",
    "dev": "vite",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:release": "node --test tests/release/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.20.2",
    "@types/three": "^0.185.4",
    "typescript": "^5.4.0",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
